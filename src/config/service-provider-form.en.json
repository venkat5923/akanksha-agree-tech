{
  "formType": "service-provider",
  "title": "Service Provider Registration",
  "description": "Register as a service provider to offer your services to farmers.",
  "sections": [
    {
      "id": "operator",
      "title": "Field Officer / Agent Information",
      "order": 1,
      "fields": [
        {
          "name": "fieldOperatorName",
          "label": "Field Operator Name",
          "type": "text",
          "placeholder": "Enter field operator / agent name",
          "required": true,
          "order": 1,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "personal",
      "title": "Personal Information",
      "order": 2,
      "fields": [
        {
          "name": "fullName",
          "label": "Full Name",
          "type": "text",
          "placeholder": "Enter your full name",
          "required": true,
          "order": 1,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        },
        {
          "name": "age",
          "label": "Age",
          "type": "number",
          "placeholder": "Enter your age",
          "required": true,
          "order": 2,
          "validation": { "min": 18, "max": 100 },
          "defaultValue": ""
        },
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "phone",
          "placeholder": "Enter your 10-digit phone number",
          "required": true,
          "order": 3,
          "validation": { "pattern": "^[0-9]{10}$" },
          "defaultValue": ""
        },
        {
          "name": "sex",
          "label": "Sex",
          "type": "radio",
          "required": true,
          "order": 4,
          "options": ["Male", "Female"],
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "address",
      "title": "Address",
      "order": 3,
      "fields": [
        {
          "name": "addressLine",
          "label": "Address Line",
          "type": "text",
          "placeholder": "Enter your address line",
          "required": true,
          "order": 1,
          "validation": { "minLength": 5, "maxLength": 100 },
          "defaultValue": ""
        },
        {
          "name": "landmark",
          "label": "Landmark",
          "type": "text",
          "placeholder": "Enter nearest landmark",
          "required": true,
          "order": 2,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        },
        {
          "name": "state",
          "label": "State",
          "type": "dropdown",
          "placeholder": "Select your state",
          "required": true,
          "order": 3,
          "options": ["Telangana", "Andhra Pradesh"],
          "defaultValue": ""
        },
        {
          "name": "zilla",
          "label": "Zilla (District)",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state"],
          "placeholder": "Select your district",
          "required": true,
          "order": 4,
          "defaultValue": null
        },
        {
          "name": "mandal",
          "label": "Mandal",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state", "zilla"],
          "placeholder": "Select your mandal",
          "required": true,
          "order": 5,
          "defaultValue": null
        }
      ]
    },
    {
      "id": "services",
      "title": "Service Details",
      "order": 4,
      "fields": [
        {
          "name": "servicesProvided",
          "label": "Select the Services You Can Provide",
          "type": "checkbox-group",
          "required": true,
          "order": 1,
          "options": ["Drone", "Tractor", "JCB", "Crop Cutting Machine", "Groundnut Machine", "Labour", "Others"],
          "defaultValue": []
        },
        {
          "name": "otherMainServiceDetails",
          "label": "Specify Other Service(s) Provided",
          "type": "text",
          "placeholder": "Enter details of other services provided",
          "required": false,
          "order": 2,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Others" }
          }
        },
        {
          "name": "droneCapabilities",
          "label": "Drone Capabilities Offered",
          "type": "multiselect",
          "placeholder": "Select drone services you offer",
          "required": false,
          "order": 3,
          "options": [
            "Pesticide Spraying",
            "Fertilizer Spraying",
            "Herbicide Spraying",
            "Seed Sowing",
            "Crop Health Monitoring",
            "Farm Mapping",
            "Soil Analysis",
            "Weed Detection",
            "Pest Detection",
            "Disease Detection",
            "Yield Estimation",
            "Plant Counting",
            "Irrigation Monitoring",
            "Land Surveying",
            "Crop Insurance Assessment",
            "Ripeness Estimation",
            "Fish Feed Dispensing",
            "Livestock Monitoring",
            "Aerial Delivery",
            "Others"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Drone" }
          }
        },
        {
          "name": "otherDroneDetails",
          "label": "Specify Other Drone Services Offered",
          "type": "text",
          "placeholder": "Enter other drone services provided",
          "required": false,
          "order": 4,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "droneCapabilities", "contains": "Others" }
          }
        },
        {
          "name": "tractorCapabilities",
          "label": "Tractor Implements Available",
          "type": "multiselect",
          "placeholder": "Select tractor implements available",
          "required": false,
          "order": 5,
          "options": [
            "Ploughing",
            "Tilling",
            "Harrowing",
            "Levelling",
            "Seed Sowing",
            "Fertilizer Application",
            "Pesticide Spraying",
            "Manure Spreading",
            "Weeding",
            "Intercultural Operations",
            "Ridging / Bed Making",
            "Trailer Hauling",
            "Crop Harvesting",
            "Threshing",
            "Post-Harvest Transport",
            "Water Pumping",
            "Loader Operations",
            "Land Clearing",
            "Road / Field Grading",
            "Baler Operations",
            "Others"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Tractor" }
          }
        },
        {
          "name": "otherTractorDetails",
          "label": "Specify Other Tractor Implements / Services",
          "type": "text",
          "placeholder": "Enter other tractor services provided",
          "required": false,
          "order": 6,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "tractorCapabilities", "contains": "Others" }
          }
        },
        {
          "name": "jcbCapabilities",
          "label": "JCB Operations Offered",
          "type": "multiselect",
          "placeholder": "Select JCB operations available",
          "required": false,
          "order": 7,
          "options": [
            "Earth Excavation",
            "Trench Digging",
            "Pit Digging",
            "Foundation Digging",
            "Material Loading",
            "Truck Loading",
            "Material Unloading",
            "Land Levelling",
            "Grading",
            "Ditch Cleaning",
            "Demolition",
            "Rubble / Debris Removal",
            "Road Breaking",
            "Rock Breaking",
            "Site Clearing",
            "Pipe Laying Support",
            "Canal / Drainage Digging",
            "Post Hole Digging",
            "Material Shifting",
            "Snow / Muck Removal",
            "Others"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "JCB" }
          }
        },
        {
          "name": "otherJcbDetails",
          "label": "Specify Other JCB Services Offered",
          "type": "text",
          "placeholder": "Enter other JCB services provided",
          "required": false,
          "order": 8,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "jcbCapabilities", "contains": "Others" }
          }
        },
        {
          "name": "cropCuttingCapabilities",
          "label": "Harvester (Crop Cutting) Capabilities",
          "type": "multiselect",
          "placeholder": "Select harvester capabilities",
          "required": false,
          "order": 9,
          "options": [
            "Wheat Cutting",
            "Paddy / Rice Harvesting",
            "Soybean Harvesting",
            "Mustard Cutting",
            "Maize Harvesting",
            "Sorghum Cutting",
            "Bajra / Millet Cutting",
            "Grass Cutting",
            "Fodder Cutting",
            "Napier Grass Cutting",
            "Sugarcane Cutting (Mini Harvester)",
            "Straw Cutting",
            "Reaping",
            "Windrowing",
            "Stubble Cutting",
            "Others"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Crop Cutting Machine" }
          }
        },
        {
          "name": "otherCropCuttingDetails",
          "label": "Specify Other Harvester Capabilities",
          "type": "text",
          "placeholder": "Enter other harvesting capabilities provided",
          "required": false,
          "order": 10,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "cropCuttingCapabilities", "contains": "Others" }
          }
        },
        {
          "name": "groundnutMachineCapabilities",
          "label": "Groundnut Machine Capabilities",
          "type": "multiselect",
          "placeholder": "Select groundnut machine capabilities",
          "required": false,
          "order": 11,
          "options": [
            "Groundnut Digging",
            "Groundnut Lifting",
            "Groundnut Drying / Curing",
            "Pod Shaking / Stripping",
            "Threshing",
            "Pod Cleaning",
            "Pod Separation (pod from haulm)",
            "Haulm Cutting / Chopping",
            "Winnowing / Grading",
            "Soil Clod Breaking",
            "Row Planting / Sowing",
            "Inverted Windrowing",
            "Others"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Groundnut Machine" }
          }
        },
        {
          "name": "otherGroundnutDetails",
          "label": "Specify Other Groundnut Machine Services",
          "type": "text",
          "placeholder": "Enter other groundnut machine services provided",
          "required": false,
          "order": 12,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "groundnutMachineCapabilities", "contains": "Others" }
          }
        },
        {
          "name": "labourCapabilities",
          "label": "Labour Team / Contractor Services Offered",
          "type": "multiselect",
          "placeholder": "Select labour services offered",
          "required": false,
          "order": 13,
          "options": [
            "Sowing & Transplantation (నాట్లు వేయుట)",
            "Weeding & Intercultural Work (కలుపు తీయుట)",
            "Harvesting & Crop Cutting (పంట కోత పనులు)",
            "Cotton Picking (పత్తి తీయుట)",
            "Chilli & Vegetable Plucking (మిర్చి/కూరగాయల కోత)",
            "Fertilizer & Pesticide Application (ఎరువులు/మందులు చల్లుట)",
            "Loading, Bagging & Transport (బస్తాలు నింపుట / లోడింగ్)",
            "General Farm Work (సాధారణ పొలం పనులు)",
            "Others"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Labour" }
          }
        },
        {
          "name": "otherLabourDetails",
          "label": "Specify Other Labour Services Offered",
          "type": "text",
          "placeholder": "Enter other labour services offered",
          "required": false,
          "order": 14,
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "labourCapabilities", "contains": "Others" }
          }
        },
        {
          "name": "availableLabourCount",
          "label": "Available Labour Team Size / Capacity",
          "type": "number",
          "placeholder": "Enter typical number of workers available",
          "required": false,
          "order": 15,
          "validation": { "min": 1, "max": 500 },
          "defaultValue": "",
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Labour" }
          }
        }
      ]
    }
  ]
}
