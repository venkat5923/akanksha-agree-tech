{
  "formType": "farmer",
  "title": "Farmer Registration",
  "description": "Register as a farmer to get started with our services.",
  "sections": [
    {
      "id": "operator",
      "title": "Field Officer / Agent Information",
      "order": 1,
      "fields": [
        {
          "name": "fieldOperatorName",
          "label": "Field Operator Name",
          "type": "text",
          "placeholder": "Enter field operator / agent name",
          "required": true,
          "order": 1,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "personal",
      "title": "Personal Information",
      "order": 2,
      "fields": [
        {
          "name": "name",
          "label": "Full Name",
          "type": "text",
          "placeholder": "Enter your full name",
          "required": true,
          "order": 1,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        },
        {
          "name": "age",
          "label": "Age",
          "type": "number",
          "placeholder": "Enter your age",
          "required": true,
          "order": 2,
          "validation": { "min": 18, "max": 100 },
          "defaultValue": ""
        },
        {
          "name": "phone",
          "label": "Phone Number",
          "type": "phone",
          "placeholder": "Enter your 10-digit phone number",
          "required": true,
          "order": 3,
          "validation": { "pattern": "^[0-9]{10}$" },
          "defaultValue": ""
        },
        {
          "name": "sex",
          "label": "Sex",
          "type": "radio",
          "required": true,
          "order": 4,
          "options": ["Male", "Female"],
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "address",
      "title": "Address",
      "order": 3,
      "fields": [
        {
          "name": "addressLine",
          "label": "Address Line",
          "type": "text",
          "placeholder": "Enter your address line",
          "required": true,
          "order": 1,
          "validation": { "minLength": 5, "maxLength": 100 },
          "defaultValue": ""
        },
        {
          "name": "landmark",
          "label": "Landmark",
          "type": "text",
          "placeholder": "Enter nearest landmark",
          "required": true,
          "order": 2,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        },
        {
          "name": "state",
          "label": "State",
          "type": "dropdown",
          "placeholder": "Select your state",
          "required": true,
          "order": 3,
          "options": ["Telangana", "Andhra Pradesh"],
          "defaultValue": ""
        },
        {
          "name": "zilla",
          "label": "Zilla (District)",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state"],
          "placeholder": "Select your district",
          "required": true,
          "order": 4,
          "defaultValue": null
        },
        {
          "name": "mandal",
          "label": "Mandal",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state", "zilla"],
          "placeholder": "Select your mandal",
          "required": true,
          "order": 5,
          "defaultValue": null
        }
      ]
    },
    {
      "id": "land",
      "title": "Land Details",
      "order": 4,
      "fields": [
        {
          "name": "landType",
          "label": "Land Type",
          "type": "dropdown",
          "placeholder": "Select your land type",
          "required": true,
          "order": 1,
          "options": ["Red", "Black", "Others"],
          "defaultValue": ""
        },
        {
          "name": "cropType",
          "label": "Crop Type",
          "type": "dropdown",
          "placeholder": "Select your crop type",
          "required": true,
          "order": 2,
          "options": ["Rice","Coconuts","Groundnuts", "Wheat", "Cotton", "Sugarcane", "Maize", "Pulses", "Vegetables", "Fruits", "Others"],
          "defaultValue": ""
        },
        {
          "name": "landArea",
          "label": "Land Area (acres)",
          "type": "number",
          "placeholder": "Enter land area in acres",
          "required": true,
          "order": 3,
          "validation": { "min": 0.1, "max": 10000 },
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "services",
      "title": "Services Needed",
      "order": 5,
      "fields": [
        {
          "name": "servicesNeeded",
          "label": "Select the Services You Need",
          "type": "checkbox-group",
          "required": true,
          "order": 1,
          "options": ["Drone", "Tractor", "JCB", "Crop Cutting Machine", "Groundnut Machine"],
          "defaultValue": []
        },
        {
          "name": "droneSprayingType",
          "label": "Drone Operations / Features",
          "type": "multiselect",
          "placeholder": "Select drone features",
          "required": false,
          "order": 2,
          "options": [
            "Pesticide Spraying",
            "Fertilizer Spraying",
            "Herbicide Spraying",
            "Seed Sowing",
            "Crop Health Monitoring",
            "Farm Mapping",
            "Soil Analysis",
            "Weed Detection",
            "Pest Detection",
            "Disease Detection",
            "Yield Estimation",
            "Plant Counting",
            "Irrigation Monitoring",
            "Land Surveying",
            "Crop Insurance Assessment",
            "Ripeness Estimation",
            "Fish Feed Dispensing",
            "Livestock Monitoring",
            "Aerial Delivery"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesNeeded", "contains": "Drone" }
          }
        },
        {
          "name": "tractorOperationType",
          "label": "Tractor Implements / Operations",
          "type": "multiselect",
          "placeholder": "Select tractor operations",
          "required": false,
          "order": 3,
          "options": [
            "Ploughing / MB Plough",
            "Rotavator",
            "Cultivator",
            "Seed Drilling / Sowing",
            "Laser Levelling",
            "Trolley / Cargo Transport"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesNeeded", "contains": "Tractor" }
          }
        },
        {
          "name": "jcbOperationType",
          "label": "JCB Operations / Features",
          "type": "multiselect",
          "placeholder": "Select JCB operations",
          "required": false,
          "order": 4,
          "options": [
            "Land Levelling & Clearing",
            "Farm Pond Excavation",
            "Trenching & Pipe Line Digging",
            "Tree Stumps & Bush Removal"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesNeeded", "contains": "JCB" }
          }
        },
        {
          "name": "cropCuttingType",
          "label": "Crop Cutting Machine (Harvester) Features",
          "type": "multiselect",
          "placeholder": "Select harvester type",
          "required": false,
          "order": 5,
          "options": [
            "Paddy / Rice Harvester",
            "Maize / Corn Harvester",
            "Wheat Harvester",
            "Straw Reaper & Baling"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesNeeded", "contains": "Crop Cutting Machine" }
          }
        },
        {
          "name": "groundnutMachineType",
          "label": "Groundnut Machine Features",
          "type": "multiselect",
          "placeholder": "Select groundnut machine type",
          "required": false,
          "order": 6,
          "options": [
            "Groundnut Digger / Harvester",
            "Groundnut Pod Separator / Thresher",
            "Decorticator / Shelling"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesNeeded", "contains": "Groundnut Machine" }
          }
        }
      ]
    }
  ]
}
