{
  "formType": "service-provider",
  "title": "సేవా ప్రదాత నమోదు",
  "description": "రైతులకు మీ సేవలను అందించడానికి సేవా ప్రదాతగా నమోదు చేసుకోండి.",
  "sections": [
    {
      "id": "operator",
      "title": "ఫీల్డ్ ఆఫీసర్ / ఏజెంట్ సమాచారం",
      "order": 1,
      "fields": [
        {
          "name": "fieldOperatorName",
          "label": "ఫీల్డ్ ఆపరేటర్ పేరు",
          "type": "text",
          "placeholder": "ఫీల్డ్ ఆపరేటర్ పేరు నమోదు చేయండి",
          "required": true,
          "order": 1,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "personal",
      "title": "వ్యక్తిగత సమాచారం",
      "order": 2,
      "fields": [
        {
          "name": "fullName",
          "label": "పూర్తి పేరు",
          "type": "text",
          "placeholder": "మీ పూర్తి పేరు నమోదు చేయండి",
          "required": true,
          "order": 1,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        },
        {
          "name": "age",
          "label": "వయస్సు",
          "type": "number",
          "placeholder": "మీ వయస్సు నమోదు చేయండి",
          "required": true,
          "order": 2,
          "validation": { "min": 18, "max": 100 },
          "defaultValue": ""
        },
        {
          "name": "phone",
          "label": "ఫోన్ నంబర్",
          "type": "phone",
          "placeholder": "మీ 10 అంకెల ఫోన్ నంబర్ నమోదు చేయండి",
          "required": true,
          "order": 3,
          "validation": { "pattern": "^[0-9]{10}$" },
          "defaultValue": ""
        },
        {
          "name": "sex",
          "label": "లింగం",
          "type": "radio",
          "required": true,
          "order": 4,
          "options": ["Male", "Female"],
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "address",
      "title": "చిరునామా",
      "order": 3,
      "fields": [
        {
          "name": "addressLine",
          "label": "చిరునామా వివరాలు",
          "type": "text",
          "placeholder": "మీ చిరునామా నమోదు చేయండి",
          "required": true,
          "order": 1,
          "validation": { "minLength": 5, "maxLength": 100 },
          "defaultValue": ""
        },
        {
          "name": "landmark",
          "label": "ల్యాండ్‌మార్క్",
          "type": "text",
          "placeholder": "సమీపంలోని ల్యాండ్‌మార్క్ నమోదు చేయండి",
          "required": true,
          "order": 2,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
        },
        {
          "name": "state",
          "label": "రాష్ట్రం",
          "type": "dropdown",
          "placeholder": "మీ రాష్ట్రాన్ని ఎంచుకండి",
          "required": true,
          "order": 3,
          "options": ["Telangana", "Andhra Pradesh"],
          "defaultValue": ""
        },
        {
          "name": "zilla",
          "label": "జిల్లా",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state"],
          "placeholder": "మీ జిల్లా ఎంచుకండి",
          "required": true,
          "order": 4,
          "defaultValue": null
        },
        {
          "name": "mandal",
          "label": "మండలం",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state", "zilla"],
          "placeholder": "మీ మండలం ఎంచుకండి",
          "required": true,
          "order": 5,
          "defaultValue": null
        }
      ]
    },
    {
      "id": "service",
      "title": "సేవా వివరాలు",
      "order": 4,
      "fields": [
        {
          "name": "servicesProvided",
          "label": "మీరు అందించగల సేవలను ఎంచుకోండి",
          "type": "checkbox-group",
          "required": true,
          "order": 1,
          "options": ["Drone", "Tractor", "JCB", "Crop Cutting Machine", "Groundnut Machine"],
          "defaultValue": []
        },
        {
          "name": "droneCapabilities",
          "label": "అందుబాటులో ఉన్న డ్రోన్ సేవలు",
          "type": "multiselect",
          "placeholder": "డ్రోన్ సామర్థ్యాలను ఎంచుకోండి",
          "required": false,
          "order": 2,
          "options": [
            "Pesticide Spraying (పురుగుమందుల స్ప్రేయింగ్)",
            "Fertilizer Spraying (ఎరువుల స్ప్రేయింగ్)",
            "Herbicide Spraying (కలుపు మందుల స్ప్రేయింగ్)",
            "Seed Sowing (విత్తనాలు చల్లుట)",
            "Crop Health Monitoring (పంట ఆరోగ్యం పర్యవేక్షణ)",
            "Farm Mapping (వ్యవసాయ భూమి మ్యాపింగ్)",
            "Soil Analysis (నేల విశ్లేషణ)",
            "Weed Detection (కలుపు మొక్కల గుర్తింపు)",
            "Pest Detection (తెగుళ్ల గుర్తింపు)",
            "Disease Detection (వ్యాధుల గుర్తింపు)",
            "Yield Estimation (దిగుబడి అంచనా)",
            "Plant Counting (మొక్కల లెక్కింపు)",
            "Irrigation Monitoring (నీటి పారుదల పర్యవేక్షణ)",
            "Land Surveying (భూమి సర్వే)",
            "Crop Insurance Assessment (పంట బీమా అంచనా)",
            "Ripeness Estimation (పంట పక్వత అంచనా)",
            "Fish Feed Dispensing (చేపల మేత పంపిణీ)",
            "Livestock Monitoring (పశువుల పర్యవేక్షణ)",
            "Aerial Delivery (గగనతల రవాణా)"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Drone" }
          }
        },
        {
          "name": "tractorCapabilities",
          "label": "అందుబాటులో ఉన్న ట్రాక్టర్ పరికరాలు",
          "type": "multiselect",
          "placeholder": "ట్రాక్టర్ పరికరాలను ఎంచుకోండి",
          "required": false,
          "order": 3,
          "options": [
            "Ploughing / MB Plough (నాగలి దుక్కి)",
            "Rotavator (రోటవేటర్)",
            "Cultivator (కల్టివేటర్)",
            "Seed Drilling / Sowing (విత్తనం వేయుట)",
            "Laser Levelling (లేజర్ లెవలింగ్)",
            "Trolley / Cargo Transport (ట్రాలీ రవాణా)"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Tractor" }
          }
        },
        {
          "name": "jcbCapabilities",
          "label": "JCB ద్వారా అందించే పనులు",
          "type": "multiselect",
          "placeholder": "JCB పనులను ఎంచుకోండి",
          "required": false,
          "order": 4,
          "options": [
            "Land Levelling & Clearing (భూమి చదును మరియు శుభ్రం)",
            "Farm Pond Excavation (రైతు కుంట తవ్వకం)",
            "Trenching & Pipe Line Digging (కాలువ / పైపులైన్ తవ్వకం)",
            "Tree Stumps & Bush Removal (చెట్లు, పొదల తొలగింపు)"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "JCB" }
          }
        },
        {
          "name": "cropCuttingCapabilities",
          "label": "హార్వెస్టర్ (పంట కోత) సామర్థ్యాలు",
          "type": "multiselect",
          "placeholder": "హార్వెస్టర్ రకాలను ఎంచుకోండి",
          "required": false,
          "order": 5,
          "options": [
            "Paddy / Rice Harvester (వరి కోత మిషన్)",
            "Maize / Corn Harvester (మొక్కజొన్న కోత మిషన్)",
            "Wheat Harvester (గోధుమ కోత మిషన్)",
            "Straw Reaper & Baling (గడ్డి చుట్టే యంత్రం)"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Crop Cutting Machine" }
          }
        },
        {
          "name": "groundnutMachineCapabilities",
          "label": "వేరుశనగ యంత్ర సామర్థ్యాలు",
          "type": "multiselect",
          "placeholder": "వేరుశనగ మిషన్ రకాలను ఎంచుకోండి",
          "required": false,
          "order": 6,
          "options": [
            "Groundnut Digger / Harvester (తవ్వకం యంత్రం)",
            "Groundnut Pod Separator / Thresher (కాయలు వేరుచేసే యంత్రం)",
            "Decorticator / Shelling (గుజ్జు/తొక్క వేరుచేసే యంత్రం)"
          ],
          "defaultValue": [],
          "conditional": {
            "showWhen": { "field": "servicesProvided", "contains": "Groundnut Machine" }
          }
        }
      ]
    }
  ]
}
