        {
          "name": "mandal",
          "label": "మండలం",
          "type": "autocomplete",
          "dataSource": "locations",
          "dependsOn": ["state", "zilla"],
          "placeholder": "మీ మండలం ఎంచుకండి",
          "required": true,
          "order": 5,
          "defaultValue": null
