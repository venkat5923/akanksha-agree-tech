        {
          "name": "phone",
          "label": "ఫోన్ నంబర్",
          "type": "phone",
          "placeholder": "మీ 10 అంకెల ఫోన్ నంబర్ నమోదు చేయండి",
          "required": true,
          "order": 3,
          "validation": { "pattern": "^[0-9]{10}$" },
          "defaultValue": ""
        },
        {
          "name": "sex",
          "label": "లింగం",
          "type": "radio",
          "required": true,
          "order": 4,
          "options": ["Male", "Female"],
          "defaultValue": ""
        }
      ]
    },
    {
      "id": "address",
      "title": "చిరునామా",
      "order": 3,
      "fields": [
        {
          "name": "addressLine",
          "label": "చిరునామా వివరాలు",
          "type": "text",
          "placeholder": "మీ చిరునామా నమోదు చేయండి",
          "required": true,
          "order": 1,
          "validation": { "minLength": 5, "maxLength": 100 },
          "defaultValue": ""
        },
        {
          "name": "landmark",
          "label": "ల్యాండ్‌మార్క్",
          "type": "text",
          "placeholder": "సమీపంలోని ల్యాండ్‌మార్క్ నమోదు చేయండి",
          "required": true,
          "order": 2,
          "validation": { "minLength": 2, "maxLength": 50 },
          "defaultValue": ""
