        {
          "name": "state",
          "label": "రాష్ట్రం",
          "type": "dropdown",
          "placeholder": "మీ రాష్ట్రాన్ని ఎంచుకండి",
          "required": true,
          "order": 3,
          "options": ["Telangana", "Andhra Pradesh"],
          "defaultValue": ""
